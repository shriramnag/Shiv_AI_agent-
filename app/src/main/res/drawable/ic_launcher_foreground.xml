<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    
    <!-- Outer Cybernetic Ring with gradient -->
    <path
        android:pathData="M54,26 C69.46,26 82,38.54 82,54 C82,69.46 69.46,82 54,82 C38.54,82 26,69.46 26,54 C26,38.54 38.54,26 54,26 Z"
        android:strokeWidth="2.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="26"
                android:startY="26"
                android:endX="82"
                android:endY="82"
                android:type="linear">
                <item android:offset="0.0" android:color="#00F0FF" />
                <item android:offset="0.5" android:color="#7000FF" />
                <item android:offset="1.0" android:color="#00F0FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Concentric Orbit -->
    <path
        android:pathData="M54,34 C65.05,34 74,42.95 74,54 C74,65.05 65.05,74 54,74 C42.95,74 34,65.05 34,54 C34,42.95 42.95,34 54,34 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#4D79FF" />

    <!-- Futuristic Chevron Nodes / Diamond Accents -->
    <path
        android:fillColor="#00F0FF"
        android:pathData="M54,20 L58,26 L50,26 Z" />
    <path
        android:fillColor="#00F0FF"
        android:pathData="M54,88 L58,82 L50,82 Z" />
    <path
        android:fillColor="#00F0FF"
        android:pathData="M20,54 L26,50 L26,58 Z" />
    <path
        android:fillColor="#00F0FF"
        android:pathData="M88,54 L82,50 L82,58 Z" />

    <!-- Central Glowing Core Sphere -->
    <path
        android:pathData="M54,42 C60.63,42 66,47.37 66,54 C66,60.63 60.63,66 54,66 C47.37,66 42,60.63 42,54 C42,47.37 47.37,42 54,42 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="42"
                android:startY="42"
                android:endX="66"
                android:endY="66"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="0.3" android:color="#00F0FF" />
                <item android:offset="1.0" android:color="#7928CA" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stylized "S" / Synapse Wave inside Core -->
    <path
        android:pathData="M50,48 C55,47 58,50 54,54 C50,58 53,61 58,60"
        android:strokeWidth="2.2"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
</vector>

